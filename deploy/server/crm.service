[Unit]
Description=AlphaRupee Collections CRM (gunicorn)
After=network.target
# Does nothing until the Django backend has been deployed
ConditionPathExists=/opt/crm/current/backend/manage.py

[Service]
User=deploy
Group=deploy
WorkingDirectory=/opt/crm/current/backend
EnvironmentFile=/opt/crm/shared/.env
ExecStart=/opt/crm/current/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 60 --access-logfile -
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
