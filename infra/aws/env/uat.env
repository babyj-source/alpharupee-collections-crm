# UAT settings. Non-secret. Edit before running create-env.sh.
AWS_REGION=ap-south-1
NAME_PREFIX=crm-uat
ENV_TAG=uat

# Network (separate from Production)
VPC_CIDR=10.20.0.0/16
PUB_CIDR_A=10.20.1.0/24
PUB_CIDR_B=10.20.2.0/24
PRIV_CIDR_A=10.20.11.0/24
PRIV_CIDR_B=10.20.12.0/24

# Sizes (UAT is smaller than Production)
APP_INSTANCE_TYPE=t3.medium
APP_DISK_GB=30
DB_INSTANCE_CLASS=db.t4g.medium
DB_STORAGE_GB=50
DB_ENGINE_VERSION=17
DB_BACKUP_DAYS=7

# Public name of the site. Create a DNS A record for it after the script prints the IP.
DOMAIN=uat-crm.alpharupee.in

# Who may reach the server. Narrow WEB_ALLOWED_CIDR to office/VPN ranges if UAT should be private.
# SSH must stay open to GitHub's runners (a wide, changing range); it is key-only for the deploy user.
WEB_ALLOWED_CIDR=0.0.0.0/0
SSH_ALLOWED_CIDR=0.0.0.0/0

# Public half of the UAT deploy key (made in docs/GITHUB_SETUP.md, step 3)
DEPLOY_PUBKEY_FILE=./crm_deploy_uat.pub
