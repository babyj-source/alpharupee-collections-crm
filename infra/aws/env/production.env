# Production settings. Non-secret. Edit ALERT_EMAIL (and check DOMAIN) before running create-env.sh.
#   bash infra/aws/create-env.sh production
AWS_REGION=ap-south-1
NAME_PREFIX=crm-prod
ENV_TAG=production

# Network (own VPC, separate from UAT's 10.20.0.0/16)
VPC_CIDR=10.30.0.0/16
PUB_CIDR_A=10.30.1.0/24
PUB_CIDR_B=10.30.2.0/24
PRIV_CIDR_A=10.30.11.0/24
PRIV_CIDR_B=10.30.12.0/24

# One application server and one database server
APP_INSTANCE_TYPE=m6i.large
APP_DISK_GB=50
APP_TERMINATION_PROTECTION=true      # the server cannot be deleted by a single click or command
APP_SNAPSHOTS=true                   # daily snapshot of the server disk, kept 14 days (02:30 IST)

DB_INSTANCE_CLASS=db.m6g.large
DB_STORAGE_GB=100
DB_MAX_STORAGE_GB=500                # storage grows by itself up to this size
DB_ENGINE_VERSION=17
DB_BACKUP_DAYS=14                    # point-in-time recovery window (35 is the most RDS allows)
DB_MULTI_AZ=false                    # one database server. Change to true later for automatic failover (about doubles the DB cost)
DB_TUNED=true                        # slow-query log, forced TLS, idle-transaction timeout, autovacuum for busy tables
DB_MAINT_WINDOW=sat:20:30-sat:21:30  # UTC = Sunday 02:00 to 03:00 IST, outside calling hours
DB_BACKUP_WINDOW=22:00-22:30         # UTC = 03:30 IST

# Public name of the site. Create a DNS A record for it after the script prints the IP.
DOMAIN=crm.alpharupee.in

# Who may reach the server. The screens are open to the internet (OTP login). SSH must stay open to GitHub's runners
# (a wide, changing range); it is key-only for the deploy user, with fail2ban.
WEB_ALLOWED_CIDR=0.0.0.0/0
SSH_ALLOWED_CIDR=0.0.0.0/0

# E-mail for alarms (server health, database CPU, disk and memory). AWS sends a confirmation message you must accept.
ALERT_EMAIL=baby.j@alpharupee.in

# The AWS secret holding the LMS read-only login (read by deploy/server/set-lms.sh)
LMS_SECRET_NAME=alpharupee/lms/readonlyuser

# Public half of the Production deploy key (made in docs/AWS_PRODUCTION_SETUP.md, step 1)
DEPLOY_PUBKEY_FILE=./crm_deploy_prod.pub
